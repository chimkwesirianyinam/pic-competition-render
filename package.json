{
  "name": "pic-competition-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.mjs",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "host:create": "node scripts/host-account.mjs",
    "deploy": "node scripts/ready.mjs && npm run check && npm run build && wrangler deploy",
    "preview:bundle": "npm run build && wrangler deploy --dry-run --outdir .worker-build",
    "pretest": "npm run check && npm run preview:bundle"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@cloudflare/workers-types": "4.20260515.1",
    "miniflare": "4.20260515.0"
  }
}
