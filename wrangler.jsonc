{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pic-competition",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/host/login",
      "/host/logout"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pic-competition",
      "database_id": "22b85f67-6fde-4466-8862-256da453fa55s",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_ORIGIN": ""
  }
}
